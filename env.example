```env
# ==========================================
# FaceVoiceID Environment Configuration
# ==========================================

# Application Settings
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Biometric Verification Thresholds
# FACE_TOLERANCE: Lower values mean stricter facial matching (Default: 0.6)
FACE_TOLERANCE=0.6

# VOICE_THRESHOLD: Maximum Euclidean distance threshold for speaker verification (Default: 15.0)
VOICE_THRESHOLD=15.0

# Audio Recording Configuration
AUDIO_SAMPLE_RATE=22050
AUDIO_DURATION=3